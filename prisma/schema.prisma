generator client {
provider = "prisma-client-js"
} 

datasource db {
provider = "postgresql"
url      = env("DATABASE_URL")
} 

// ========== USER ========== 

model User {
id            String    @id @default(cuid())
email         String    @unique
name          String
username      String    @unique
image         String?
bio           String?
isActive      Boolean   @default(true)
isVerified    Boolean   @default(false)
createdAt     DateTime  @default(now())
updatedAt     DateTime  @updatedAt
emailVerified DateTime?
role          UserRole  @default(STUDENT)
department    String?
semester      String?
rollNumber    String?   

accounts      Account[]
reports       Reports[] @relation("UserReports") 

posts         Post[]
comments      Comment[]
likes         Like[] 

sentFriendRequests     FriendRequest[] @relation("FriendRequester")
receivedFriendRequests FriendRequest[] @relation("FriendReceiver") 

sentMessages     Message[] @relation("MessageSender")
receivedMessages Message[] @relation("MessageReceiver") 

fromUser       Notification[] @relation("NotificationSender")
mentioned      Mention[]
conversations  ConversationParticipant[]
Session        Session[]
notifications  Notification[] 

postedNotices  Notice[] @relation("NoticeAuthor")
noticeViews    NoticeView[]
savedNotices   SavedNotice[] 
@@index([rollNumber])
@@map("users")
} 

// ========== AUTH MODELS ========== 

model Account {
id                String  @id @default(cuid())
userId            String
type              String
provider          String
providerAccountId String
refresh_token     String? @db.Text
access_token      String? @db.Text
expires_at        Int?
token_type        String?
scope             String?
id_token          String? @db.Text
session_state     String? 

user User @relation(fields: [userId], references: [id], onDelete: Cascade) 

@@unique([provider, providerAccountId])
@@index([userId])
@@map("accounts")
} 

model Session {
id           String   @id @default(cuid())
sessionToken String   @unique
userId       String
expires      DateTime
user         User     @relation(fields: [userId], references: [id], onDelete: Cascade) 

@@index([userId])
@@map("sessions")
} 

model VerificationToken {
identifier String
token      String   @unique
expires    DateTime 

@@unique([identifier, token])
@@map("verification_tokens")
} 

// ========== POSTS & FEED ========== 

model Post {
id        String   @id @default(cuid())
content   String
imageUrl  String?
isUpdated Boolean  @default(false)
authorId  String
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt 

reports       Reports[] @relation("PostReports")
author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade) 

comments      Comment[]
likes         Like[]
notifications Notification[]
mentions      Mention[] 

@@index([authorId])
@@index([createdAt(sort: Desc)])
@@map("posts")
} 

model Comment {
id        String   @id @default(cuid())
content   String
postId    String
authorId  String
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt 

post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
notice   Notice? @relation(fields: [noticeId], references: [id])
noticeId String? 

@@index([postId, createdAt])
@@index([authorId])
@@index([noticeId])
@@map("comments")
} 

model Like {
id        String   @id @default(cuid())
postId    String
userId    String
createdAt DateTime @default(now()) 

post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
notice   Notice? @relation(fields: [noticeId], references: [id])
noticeId String? 

@@unique([postId, userId])
@@index([userId])
@@index([noticeId])
@@map("likes")
} 

// ========== FRIENDSHIP ========== 

model FriendRequest {
id          String           @id @default(cuid())
requesterId String
receiverId  String
status      FriendshipStatus @default(PENDING)
createdAt   DateTime         @default(now())
updatedAt   DateTime         @updatedAt 

requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
receiver  User @relation("FriendReceiver", fields: [receiverId], references: [id], onDelete: Cascade) 

@@unique([requesterId, receiverId])
@@index([receiverId, status])
@@map("friend_requests")
} 

// ========== MESSAGING ========== 

model Conversation {
id        String           @id @default(cuid())
type      ConversationType @default(DIRECT)
name      String?
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt 

participants ConversationParticipant[]
messages     Message[] 

@@index([updatedAt(sort: Desc)])
@@map("conversations")
} 

model ConversationParticipant {
id             String   @id @default(cuid())
conversationId String
userId         String
joinedAt       DateTime @default(now()) 

conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
user         User         @relation(fields: [userId], references: [id], onDelete: Cascade) 

@@unique([conversationId, userId])
@@index([userId])
@@map("conversation_participants")
} 

model Message {
id             String   @id @default(cuid())
content        String
senderId       String
receiverId     String?
conversationId String?
isRead         Boolean  @default(false)
createdAt      DateTime @default(now())
updatedAt      DateTime @updatedAt 

sender       User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
receiver     User?         @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: SetNull)
conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade) 

@@index([conversationId, createdAt])
@@index([senderId])
@@index([receiverId])
@@map("messages")
} 

// ========== REPORT SYSTEM ========== 

model Reports {
id        String   @id @default(cuid())
reason    String
details   String?
createdAt DateTime @default(now()) 

postId   String
userId   String
noticeId String? 

post   Post   @relation("PostReports", fields: [postId], references: [id], onDelete: Cascade)
user   User   @relation("UserReports", fields: [userId], references: [id], onDelete: Cascade)
notice Notice? @relation(fields: [noticeId], references: [id]) 

@@index([postId])
@@index([userId])
@@index([noticeId])
} 

// ========== NOTIFICATION ========== 

model Notification {
id        String           @id @default(cuid())
type      NotificationType
message   String
link      String?
isRead    Boolean          @default(false)
createdAt DateTime         @default(now()) 

userId     String
fromUserId String?
postId     String?
noticeId   String? 

user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
fromUser  User?  @relation("NotificationSender", fields: [fromUserId], references: [id])
post      Post?  @relation(fields: [postId], references: [id], onDelete: Cascade)
notice    Notice? @relation(fields: [noticeId], references: [id]) 

@@index([userId, isRead, createdAt(sort: Desc)])
@@index([fromUserId])
@@index([postId])
@@index([noticeId])
} 

// ========== MENTIONS ========== 

model Mention {
id          String   @id @default(cuid())
postId      String
mentionedId String
noticeId    String?
createdAt   DateTime @default(now()) 

post      Post    @relation(fields: [postId], references: [id])
mentioned User    @relation(fields: [mentionedId], references: [id])
notice    Notice? @relation(fields: [noticeId], references: [id]) 

@@index([postId])
@@index([mentionedId])
@@index([noticeId])
} 

// ========== BUG REPORT ========== 

model BugReport {
id            String   @id @default(cuid())
title         String
details       String
steps         String
severity      String
reporterEmail String?
attachments   String[]
createdAt     DateTime @default(now()) 

@@index([createdAt(sort: Desc)])
} 

// ========== NOTICE SYSTEM ==========

model Notice {
  id            String   @id @default(cuid())
  title         String
  content       String   @db.Text
  category      NoticeCategory @default(GENERAL)
  priority      NoticePriority @default(MEDIUM)
  authorId      String
  department    String?
  semester      String?
  attachments   String[]
  isPinned      Boolean  @default(false)
  isPublished   Boolean  @default(true)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author        User @relation("NoticeAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  views         NoticeView[]
  savedBy       SavedNotice[]

  // Opposing relation fields to fix the validation errors:
  comments      Comment[]
  likes         Like[]
  reports       Reports[]
  notifications Notification[]
  mentions      Mention[]

  @@index([authorId])
  @@index([department, semester])
  @@index([isPinned, createdAt(sort: Desc)])
  @@map("notices")
}


model NoticeView {
id        String   @id @default(cuid())
noticeId  String
userId    String
viewedAt  DateTime @default(now()) 

notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) 

@@unique([noticeId, userId])
@@index([userId])
@@map("notice_views")
} 

model SavedNotice {
id        String   @id @default(cuid())
noticeId  String
userId    String
savedAt   DateTime @default(now()) 

notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) 

@@unique([noticeId, userId])
@@index([userId])
@@map("saved_notices")
} 

// ENUMS 

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
  STAFF
}

enum NoticeCategory {
  ACADEMIC
  EXAM
  EVENT
  HOLIDAY
  RESULT
  ADMISSION
  SCHOLARSHIP
  PLACEMENT
  SPORTS
  CULTURAL
  GENERAL
  URGENT
}

enum NoticePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum NotificationType {
  LIKE
  COMMENT
  FRIEND_REQUEST
  FRIEND_ACCEPT
  MENTION
  REPORT
  SYSTEM
}
